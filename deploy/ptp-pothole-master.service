[Unit]
Description=Common hardware PTP master for CU22 and Hesai XT32
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/hudaters/Desktop/live_detection
ExecStart=/usr/bin/python3 -u /home/hudaters/Desktop/live_detection/ptp_service.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
