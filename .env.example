# main_live.py upload settings for this unit (copy to .env and fill in; .env is not in git)
# record_id terminal name; empty uses the host name
PORTHOLE_TERMINAL_ID=
# API server: when PORTHOLE_API_URL is set, JPG/JSON/PCAP are POSTed there and the SSH settings are ignored
PORTHOLE_API_URL=
PORTHOLE_API_TOKEN=
# SSH receiver, used while PORTHOLE_API_URL is empty
PORTHOLE_UPLOAD_HOST=
PORTHOLE_UPLOAD_USER=
PORTHOLE_UPLOAD_DIR=
PORTHOLE_UPLOAD_KEY=
