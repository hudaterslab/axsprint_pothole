# live_pothole.py upload settings for this unit (copy to .env and fill in; .env is not in git)
# record_id terminal name; empty uses the host name
PORTHOLE_TERMINAL_ID=
# API server: when PORTHOLE_API_URL is set, JPG/JSON/PCAP are POSTed there instead of PORTHOLE_UPLOAD_DIR
PORTHOLE_API_URL=
PORTHOLE_API_TOKEN=
# SSH server: detections go to PORTHOLE_UPLOAD_DIR while PORTHOLE_API_URL is empty
PORTHOLE_UPLOAD_HOST=
PORTHOLE_UPLOAD_USER=
PORTHOLE_UPLOAD_DIR=
PORTHOLE_UPLOAD_KEY=
# Finished recordings, as they are on the SSD, go to <PORTHOLE_RAW_DIR>/<date>/<run> on the SSH server only with
# PORTHOLE_RAW_UPLOAD=true (false, the default, keeps them on the terminal; the detections are sent either way).
# Several terminals on one server need their own PORTHOLE_UPLOAD_DIR and PORTHOLE_RAW_DIR: run folder names come
# from the clock, so two cars recording at the same time would overwrite each other's files.
PORTHOLE_RAW_UPLOAD=false
PORTHOLE_RAW_DIR=
