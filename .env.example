# main_live.py 설정. 이 파일을 main_live.py 옆에 .env로 복사해서 채우세요.
# .env는 저장소에 올라가지 않습니다(.gitignore).

# 탐지 결과 업로드 (SSH). 업로드는 기본으로 켜져 있으며(--no-upload로 끔),
# 네 값이 모두 있어야 업로드합니다. 없으면 분석은 계속하고 업로드만 멈춥니다.
PORTHOLE_UPLOAD_HOST=
PORTHOLE_UPLOAD_USER=
PORTHOLE_UPLOAD_DIR=
# 예: ~/.ssh/upload_ed25519 (서버의 호스트 키가 known_hosts에 있어야 합니다)
PORTHOLE_UPLOAD_KEY=
# 업로드 속도 제한 KiB/s (기본 24576)
# PORTHOLE_UPLOAD_BW_KIB=24576

# 기상청 API (선택). 없으면 날씨 항목이 비어 있습니다.
# KMA_SERVICE_KEY=
# KMA_ASOS_SERVICE_KEY=
# KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# KMA_ASOS_BASE_URL=https://apis.data.go.kr/1360000/AsosHourlyInfoService

# 결과에 기록할 차량 종류 (선택, 기본 현대 팰리세이드)
# DAMAGE_EXPORT_VEHICLE_TYPE=
